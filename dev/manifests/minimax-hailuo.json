{
  "name": "minimax-hailuo",
  "version": "0.1.2",
  "api": "vivijure-module/2",
  "hooks": [
    "motion.backend"
  ],
  "provides": [
    {
      "id": "i2v-cloud",
      "label": "Silent physical (Hailuo)"
    }
  ],
  "config_schema": {
    "enable_prompt_expansion": {
      "type": "bool",
      "default": true,
      "label": "expand prompt"
    },
    "go_fast": {
      "type": "bool",
      "default": true,
      "label": "fast mode"
    }
  },
  "ui": {
    "section": "motion",
    "order": 40,
    "locality": "cloud",
    "cost": "$0.19/s",
    "cost_as_of": "2026-11-05",
    "cost_usd_per_second": [
      0.19,
      0.19
    ],
    "blurb": "Physical motion, silent. 6 or 10 seconds. No spoken lines.",
    "limits": [
      "6 or 10 second clips",
      "Silent motion",
      "No spoken lines. A board with a line needs a talking door"
    ]
  },
  "usage": {
    "face_hold": "one",
    "native_audio": false,
    "voice": "cast_tts",
    "scatter_native_audio": true,
    "min_seconds": 6,
    "max_seconds": 10,
    "duration_steps": [
      6,
      10
    ]
  }
}

{
  "name": "minimax-hailuo",
  "version": "0.1.1",
  "api": "vivijure-module/2",
  "hooks": [
    "motion.backend"
  ],
  "provides": [
    {
      "id": "i2v-cloud",
      "label": "Silent physical (Hailuo)"
    }
  ],
  "config_schema": {
    "enable_prompt_expansion": {
      "type": "bool",
      "default": true,
      "label": "expand prompt"
    },
    "go_fast": {
      "type": "bool",
      "default": true,
      "label": "fast mode"
    }
  },
  "ui": {
    "section": "motion",
    "order": 40,
    "locality": "cloud",
    "cost": "Pay per render",
    "blurb": "Physical motion, silent. 6 or 10 seconds. Cast voice + MuseTalk if they speak.",
    "limits": [
      "6 or 10 second clips",
      "Silent motion",
      "Speaking is Cast voice plus MuseTalk"
    ]
  },
  "usage": {
    "native_audio": false,
    "voice": "cast_tts",
    "scatter_native_audio": true,
    "min_seconds": 6,
    "max_seconds": 10,
    "duration_steps": [
      6,
      10
    ]
  }
}

{
  "name": "cloud-keyframe",
  "version": "0.1.13",
  "cancelable": true,
  "api": "vivijure-module/2",
  "hooks": [
    "keyframe"
  ],
  "provides": [
    {
      "id": "cloud-keyframe",
      "label": "Cloud Keyframe (reference-conditioned, GPUless)"
    }
  ],
  "config_schema": {
    "model": {
      "type": "enum",
      "values": [
        "google/nano-banana-2",
        "google/nano-banana-2.1",
        "pruna/p-image-edit"
      ],
      "default": "google/nano-banana-2",
      "label": "image model"
    },
    "width": {
      "type": "int",
      "default": 1344,
      "min": 512,
      "max": 1536,
      "label": "width"
    },
    "height": {
      "type": "int",
      "default": 768,
      "min": 512,
      "max": 1536,
      "label": "height"
    },
    "refs_per_slot": {
      "type": "int",
      "default": 1,
      "min": 1,
      "max": 4,
      "label": "reference images per character"
    },
    "film_ref": {
      "type": "string",
      "default": "first_keyframe",
      "label": "film-wide reference lock (none | first_keyframe | cast:<slot>)"
    },
    "style": {
      "type": "enum",
      "values": [
        "photoreal",
        "anime"
      ],
      "default": "photoreal",
      "label": "still look"
    }
  },
  "ui": {
    "section": "keyframe",
    "order": 5
  }
}

{
  "name": "finish-upscale",
  "version": "0.2.2",
  "api": "vivijure-module/2",
  "hooks": [
    "finish"
  ],
  "max_invocation_seconds": 900,
  "provides": [
    {
      "id": "upscale",
      "label": "Upscale resolution (Real-ESRGAN)"
    }
  ],
  "config_schema": {
    "style": {
      "type": "enum",
      "values": [
        "photoreal",
        "anime"
      ],
      "default": "photoreal",
      "label": "still look"
    },
    "scale": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 4,
      "label": "upscale size",
      "enum_labels": {
        "0": "to delivery height",
        "2": "2x",
        "4": "4x"
      }
    },
    "model": {
      "type": "enum",
      "values": [
        "realesr-animevideov3",
        "RealESRGAN_x4plus"
      ],
      "default": "realesr-animevideov3",
      "label": "model"
    }
  },
  "ui": {
    "section": "finish",
    "icon": "expand",
    "order": 20
  },
  "finish_scales_frame": true,
  "participation": "opt_in",
  "cancelable": true,
  "finish_artifacts": {
    "output_key": {
      "kind": "append_suffix",
      "suffix": "_up"
    },
    "applied": [
      {
        "tag": "upscale:{scale|2}x"
      }
    ]
  }
}

{
  "name": "plan-enhance",
  "version": "0.3.1",
  "api": "vivijure-module/2",
  "hooks": [
    "plan.enhance"
  ],
  "provides": [
    {
      "id": "ollama-direction",
      "label": "Ollama auto-direction (homelab)"
    }
  ],
  "config_schema": {
    "model": {
      "type": "enum",
      "values": [
        "ollama/qwen3:14b",
        "ollama/deepseek-r1:14b",
        "ollama/qwen3:8b",
        "anthropic/claude-opus-4-8",
        "anthropic/claude-opus-4-7",
        "anthropic/claude-sonnet-5",
        "anthropic/claude-sonnet-4-6"
      ],
      "default": "ollama/qwen3:14b",
      "label": "model"
    },
    "intensity": {
      "type": "enum",
      "values": [
        "light",
        "medium",
        "bold"
      ],
      "default": "medium",
      "label": "direction intensity"
    }
  },
  "ui": {
    "section": "plan",
    "order": 10
  }
}

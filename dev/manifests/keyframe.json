{
  "name": "keyframe",
  "version": "0.3.11",
  "api": "vivijure-module/2",
  "hooks": [
    "keyframe"
  ],
  "provides": [
    {
      "id": "gpu-keyframe",
      "label": "GPU Keyframe (SDXL on RunPod)"
    }
  ],
  "config_schema": {
    "quality_tier": {
      "type": "enum",
      "values": [
        "draft",
        "standard",
        "final"
      ],
      "default": "final",
      "label": "quality tier"
    },
    "width": {
      "type": "int",
      "default": 1344,
      "min": 512,
      "max": 1536,
      "label": "width"
    },
    "height": {
      "type": "int",
      "default": 768,
      "min": 512,
      "max": 1536,
      "label": "height"
    },
    "steps": {
      "type": "int",
      "default": 30,
      "min": 1,
      "max": 60,
      "label": "diffusion steps"
    },
    "guidance_scale": {
      "type": "float",
      "default": 6.5,
      "min": 0,
      "max": 20,
      "label": "guidance scale"
    },
    "seed": {
      "type": "int",
      "default": -1,
      "min": -1,
      "label": "seed (-1 = backend default, same picture each time)"
    },
    "identity_method": {
      "type": "enum",
      "values": [
        "ip_adapter",
        "instantid"
      ],
      "default": "ip_adapter",
      "label": "face identity method"
    },
    "scene_lock": {
      "type": "bool",
      "default": true,
      "label": "keep people in the scene"
    },
    "canny_scale": {
      "type": "float",
      "default": 0.7,
      "min": 0,
      "max": 1,
      "label": "scene lock strength"
    },
    "face_crop_pad": {
      "type": "float",
      "default": 0.35,
      "min": 0,
      "max": 2,
      "label": "face reference margin"
    },
    "plate_ip_adapter_scale": {
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "label": "two-person portrait strength"
    },
    "plate_regional_text": {
      "type": "bool",
      "default": true,
      "label": "keep each person's look to themselves"
    },
    "plate_people_free_background": {
      "type": "bool",
      "default": false,
      "label": "nobody in the gap between two people"
    },
    "pose_scale": {
      "type": "float",
      "default": 0.3,
      "min": 0,
      "max": 1.5,
      "label": "two-person body placement strength"
    },
    "pose_conditioning": {
      "type": "enum",
      "values": [
        "auto",
        "on",
        "off"
      ],
      "default": "on",
      "label": "two-person pose skeleton"
    },
    "pose_template": {
      "type": "enum",
      "values": [
        "stand",
        "reach",
        "auto"
      ],
      "default": "stand",
      "label": "two-person pose figure"
    },
    "style": {
      "type": "enum",
      "values": [
        "photoreal",
        "anime"
      ],
      "default": "photoreal",
      "label": "still look"
    }
  },
  "ui": {
    "section": "keyframe",
    "order": 10
  },
  "cancelable": true,
  "keyframe_label": "SDXL",
  "needs_tenant_r2": true,
  "trains_loras": true
}
